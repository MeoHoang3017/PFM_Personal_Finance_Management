# ============================================
# Server Configuration
# ============================================
# Port number for the server
PORT=5000

# Environment: development, production, test
NODE_ENV=development

# Client URLs (comma-separated for multiple origins)
# Example: http://localhost:3000,http://localhost:5173
CLIENT_URL=http://localhost:3000,http://localhost:5173

# API URL for Swagger documentation
API_URL=http://localhost:5000

# Timezone for scheduled tasks
TZ=UTC

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Example: mongodb://localhost:27017/pfm_db
# Or: mongodb+srv://username:password@cluster.mongodb.net/pfm_db
MONGO_URI=

# ============================================
# Redis Configuration
# ============================================
# Redis connection URL
# Example: redis://localhost:6379
# Or: redis://:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================
# JWT & Security Configuration
# ============================================
# Access token secret key (minimum 32 characters recommended)
# Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET_KEY=

# Refresh token secret key (minimum 32 characters recommended)
# Generate with: openssl rand -base64 32
REFRESH_TOKEN_SECRET_KEY=

# Alternative name for access token secret (if different from above)
# JWT_ACCESS_SECRET_KEY=

# JWT encryption key (32 bytes, hex or base64/base64url format)
# Optional: If not provided, will derive from ACCESS_TOKEN_SECRET_KEY
# Generate with: openssl rand -hex 32
# JWT_ENC_KEY=

# ============================================
# Email Configuration (OAuth2 for Gmail)
# ============================================
# Gmail address to send emails from
EMAIL_USER=

# OAuth2 Client ID from Google Cloud Console
OAUTH_CLIENT_ID=

# OAuth2 Client Secret from Google Cloud Console
OAUTH_CLIENT_SECRET=

# OAuth2 Refresh Token (obtained from OAuth2 flow)
OAUTH_REFRESH_TOKEN=

# Display name for email sender
SEND_NAME=Personal Finance Management

# ============================================
# Google Login Configuration
# ============================================
# Google OAuth2 Web Client ID (required)
GOOGLE_WEB_CLIENT_ID=

# Google OAuth2 iOS Client ID (optional, for iOS app)
# GOOGLE_IOS_CLIENT_ID=

# Google OAuth2 Android Client ID (optional, for Android app)
# GOOGLE_ANDROID_CLIENT_ID=

# ============================================
# Exchange Rate API Configuration
# ============================================
# Exchange rate API key (required for some providers like Fixer.io)
# For exchangerate-api.com, API key is optional
EXCHANGE_RATE_API_KEY=

# Exchange rate API provider: 'exchangerate-api' or 'fixer'
# Default: exchangerate-api
EXCHANGE_RATE_API_PROVIDER=exchangerate-api

# Enable/disable automatic exchange rate updates
# Set to 'false' to disable auto-updates
EXCHANGE_RATE_AUTO_UPDATE=true

# Cron schedule for exchange rate updates (default: daily at 2 AM UTC)
# Format: minute hour day month dayOfWeek
# Example: "0 2 * * *" = daily at 2:00 AM
EXCHANGE_RATE_UPDATE_SCHEDULE=0 2 * * *

# Base currency for exchange rates (default: USD)
EXCHANGE_RATE_BASE_CURRENCY=USD

# ============================================
# OTP Configuration
# ============================================
# OTP expiration time in minutes (default: 10)
OTP_EXPIRES_MINUTES=10
