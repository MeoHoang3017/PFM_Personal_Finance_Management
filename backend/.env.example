# ============================================
# Server Configuration
# ============================================
# Port number for the server
PORT=5000

# Environment: development, production, test
NODE_ENV=development

# Client URLs (comma-separated for multiple origins)
# Example: http://localhost:3000,http://localhost:5173
CLIENT_URL=http://localhost:3000,http://localhost:5173

# API URL for Swagger documentation
API_URL=http://localhost:5000

# Timezone for scheduled tasks
TZ=UTC

# ============================================
# Database Configuration
# ============================================
# MongoDB connection string
# Example: mongodb://localhost:27017/pfm_db
# Or: mongodb+srv://username:password@cluster.mongodb.net/pfm_db
MONGO_URI=

# Use MongoDB transactions when available (replica set). On standalone, backend auto-fallbacks to manual rollback.
# See backend/docs/MONGODB_TRANSACTIONS.md
# USE_MONGODB_TRANSACTIONS=true

# ============================================
# Redis Configuration
# ============================================
# Redis connection URL
# Example: redis://localhost:6379
# Or: redis://:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================
# JWT & Security Configuration
# ============================================
# Access token secret key (minimum 32 characters recommended)
# Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET_KEY=

# Refresh token secret key (minimum 32 characters recommended)
# Generate with: openssl rand -base64 32
REFRESH_TOKEN_SECRET_KEY=

# Alternative name for access token secret (if different from above)
# JWT_ACCESS_SECRET_KEY=

# JWT encryption key (32 bytes, hex or base64/base64url format)
# Optional: If not provided, will derive from ACCESS_TOKEN_SECRET_KEY
# Generate with: openssl rand -hex 32
# JWT_ENC_KEY=

# ============================================
# Email Configuration (Gmail App Password)
# ============================================
# Gmail address to send emails from (OTP, reset password, etc.)
EMAIL_USER=

# Gmail App Password (not your normal password).
# Enable 2-Step Verification, then create at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=

# Display name for email sender
SEND_NAME=Personal Finance Management

# Optional: OAuth2 for Gmail (if not using App Password)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REFRESH_TOKEN=

# ============================================
# Google Login Configuration
# ============================================
# Chi tiết từng bước + file/biến cho 3 credential (Web, Android, iOS): xem ../docs/GOOGLE_OAUTH_3_CREDENTIALS_SETUP.md
#
# Bắt buộc: Web Client ID (OAuth 2.0 "Web application" trong Google Cloud Console).
# Flutter GOOGLE_SERVER_CLIENT_ID phải = giá trị này. Backend dùng để verify id_token.
GOOGLE_WEB_CLIENT_ID=

# (Tùy chọn) Alias: cùng giá trị với GOOGLE_WEB_CLIENT_ID
# GOOGLE_CLIENT_ID=

# (Tùy chọn) Client ID riêng cho iOS / Android nếu đã tạo 3 credential trong Console
# Lấy: Credentials → iOS / Android → Client ID
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# ============================================
# Exchange Rate API Configuration
# ============================================
# Exchange rate API key (required for ExchangeRate-API v6 and Fixer.io)
# Get a free key: https://www.exchangerate-api.com/
# Example request: https://v6.exchangerate-api.com/v6/YOUR-API-KEY/latest/USD
EXCHANGE_RATE_API_KEY=

# Exchange rate API provider: 'exchangerate-api' (v6), 'fixer', 'currencylayer'
# Default: exchangerate-api (uses v6 endpoint with API key)
EXCHANGE_RATE_API_PROVIDER=exchangerate-api

# Enable/disable automatic exchange rate updates
# Set to 'false' to disable auto-updates
EXCHANGE_RATE_AUTO_UPDATE=true

# Cron schedule for exchange rate updates (default: daily at 2 AM UTC)
# Format: minute hour day month dayOfWeek
# Example: "0 2 * * *" = daily at 2:00 AM
EXCHANGE_RATE_UPDATE_SCHEDULE=0 2 * * *

# Base currency for exchange rates (default: USD)
EXCHANGE_RATE_BASE_CURRENCY=USD

# ============================================
# OTP Configuration
# ============================================
# OTP expiration time in minutes (default: 10)
OTP_EXPIRES_MINUTES=10
